# --- Required ---
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678
# Comma-separated bot user IDs allowed to send prompts (e.g. PandaQA's bot ID).
# All other bot messages are ignored to prevent loops.
TRUSTED_BOT_IDS=

# --- LLM profiles (multi-profile system — !deepseek / !haiku / !gemma / !qwen to switch) ---
# Each profile is defined by PANDABOT_PROFILE_<NAME>_TYPE and related vars.
# PANDABOT_DEFAULT_PROFILE sets which profile is active on startup.
#
# Anthropic (Claude) profile:
PANDABOT_PROFILE_HAIKU_TYPE=anthropic
PANDABOT_PROFILE_HAIKU_PRIMARY=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-...
#
# DeepSeek profile (OpenAI-compatible remote):
# PANDABOT_PROFILE_DEEPSEEK_TYPE=openai_compat
# PANDABOT_PROFILE_DEEPSEEK_URL=https://api.deepseek.com
# PANDABOT_PROFILE_DEEPSEEK_KEY=sk-...
# PANDABOT_PROFILE_DEEPSEEK_PRIMARY=deepseek-v4-flash
#
# Local llama.cpp profiles (both share port 8081; only one loads at a time):
# PANDABOT_PROFILE_GEMMA_TYPE=openai_compat
# PANDABOT_PROFILE_GEMMA_URL=http://127.0.0.1:8081/v1
# PANDABOT_PROFILE_GEMMA_KEY=no-key
# PANDABOT_PROFILE_GEMMA_PRIMARY=gemma-3-1b-it
#
# PANDABOT_PROFILE_QWEN_TYPE=openai_compat
# PANDABOT_PROFILE_QWEN_URL=http://127.0.0.1:8081/v1
# PANDABOT_PROFILE_QWEN_KEY=no-key
# PANDABOT_PROFILE_QWEN_PRIMARY=qwen2.5-3b-instruct
#
PANDABOT_DEFAULT_PROFILE=haiku
#
# Local LLM service management (!gemma / !qwen trigger switch-model.sh):
# ENABLE_LOCAL_LLM=true
# LOCAL_LLM_PROFILE_NAME=gemma   # which profile name maps to the !gemma command
# LLAMA_LOCAL_PROFILES=gemma,qwen

# --- Jenkins ---
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-jenkins-api-token

# --- Webhook (Jenkins → bot notifications) ---
WEBHOOK_PORT=8765
WEBHOOK_SECRET=your-webhook-secret

# --- Network ---
TAILSCALE_IP=100.x.x.x

# --- Jellyfin ---
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-api-key

# --- Azure App Insights (optional — needed for query_ripping: recent_rips and telemetry) ---
APPINSIGHTS_APP_ID=your-app-insights-application-id
APPINSIGHTS_IKEY=your-instrumentation-key
APPINSIGHTS_ENDPOINT=https://eastus-8.in.applicationinsights.azure.com/v2/track
AZURE_TENANT_ID=your-entra-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret

# --- Storage paths ---
STAGING_PATH=/mnt/media/Video
MEDIA_PATH=/mnt/media/Media

# --- Proactive alerts ---
DISK_ALERT_THRESHOLD_PCT=85
DISK_ALERT_PATH=/mnt/media
WATCHDOG_SERVICES=jellyfin,sunshine

# --- OpenProject (optional — project/task management) ---
# API key: OpenProject → My Account → Access Tokens → Generate "API" token.
# The bot account must be an OpenProject administrator to create projects.
# ENABLE_OPENPROJECT=true
# OPENPROJECT_URL=https://plan.jpelletier.com
# OPENPROJECT_API_KEY=your-openproject-api-token

# --- Feature flags (set to false to disable entire subsystems) ---
ENABLE_JELLYFIN=true
ENABLE_JENKINS=true
ENABLE_RIPPING=true
ENABLE_SMART=true

# --- Bot identity ---
BOT_NAME=Panda
BOT_EMOJI=🐼

# --- Server description ---
# Leave SERVER_DESCRIPTION blank to auto-build from feature flags.
# Set it to a plain-English paragraph describing your server for the system prompt.
SERVER_DESCRIPTION=
HARDWARE_DESCRIPTION=NVIDIA GTX 970 (4 GB VRAM), 2 TB NTFS HDD at /mnt/media

# --- Timezone (used in system prompt and timestamp display) ---
TZ_NAME=America/New_York (Eastern Time, EDT/EST)

# --- Service whitelists (comma-separated; defaults match panda config) ---
DOCKER_LOG_CONTAINERS=jellyfin,jenkins,excalidraw,excalidraw-room
SYSTEMD_SERVICES=sunshine,tailscaled,cockpit,ssh
RESTARTABLE_CONTAINERS=jellyfin,jenkins,excalidraw,excalidraw-room
FILE_LOGS=rip-video:/var/log/rip-video.log,rip-cd:/var/log/rip-cd.log
JENKINS_JOBS=Login_Test,Process_Movies,Nightly_Convert

# --- SMART drive devices (device:label, comma-separated) ---
SMART_DEVICES=/dev/sda:SanDisk SSD PLUS (boot),/dev/sdb:Seagate ST4000DM004 (media)

# --- AI Crawl Analytics (optional — custom HTTP analytics endpoint, off by default) ---
# ENABLE_CRAWL_ANALYTICS=true
# CRAWL_ANALYTICS_URL=https://your-analytics-endpoint.example.com
# CRAWL_ANALYTICS_TOKEN=your-admin-token

# --- Family lookup (optional — Google Sheets-backed family relationship info) ---
# ENABLE_FAMILY=true
# FAMILY_SPREADSHEET_ID=your-spreadsheet-id
# FAMILY_SHEET_NAME=Sheet1
# FAMILY_CREDENTIALS_PATH=/path/to/service-account.json

# --- TTS / Voice (optional — Kokoro-82M local TTS via Docker at port 8880) ---
# Set ENABLE_TTS=true and run kokoro/docker-compose.yml to enable voice responses.
# Requires ffmpeg installed on the host and the bot token to have voice permissions.
# ENABLE_TTS=true
# TTS_URL=http://localhost:8880
# TTS_VOICE=af_heart
# TTS_IDLE_TIMEOUT_SECS=300
# TTS_AUTO_JOIN_CHANNEL_ID=123456789012345678  # voice channel ID to watch; bot joins on entry, leaves when empty

# --- STT / Voice input (optional — faster-whisper medium via Docker at port 8001) ---
# Requires stt/docker-compose.yml to be running on the server.
# ENABLE_STT=true
# STT_URL=http://localhost:8001
# STT_MODEL=medium
# STT_SILENCE_TIMEOUT_SECS=1.5   # seconds of silence before utterance is sent for transcription
# STT_RMS_THRESHOLD=500          # raise to ignore background noise; lower if mic is quiet
